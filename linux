#!/usr/bin/env sh

# Ambil nama folder kerja saat ini
DIRNAME=$(basename "$PWD")

# Helper: cek command
has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

case "$1" in
  run)
    if [ ! -d "node_modules" ]; then
      echo "Folder 'node_modules' tidak ditemukan. Menjalankan 'npm install'..."
      npm install || exit 1
    fi
    node .
    ;;

  bun-run)
    if ! has_cmd bun; then
      echo "Bun tidak ditemukan. Menginstal Bun..."
      curl -fsSL https://bun.sh/install | bash || exit 1
      # reload env bila perlu
      [ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc"
    fi
    if [ ! -d "node_modules" ]; then
      echo "Folder 'node_modules' tidak ditemukan. Menjalankan 'bun install'..."
      bun install || exit 1
    fi
    bun .
    ;;

  install)
    DATE=$(date +"%Y%m%d" 2>/dev/null || date +%Y%m%d)
    git clone https://github.com/Barqah-Xiex/brainxiex-bot-whatsapp.git "$DATE" || exit 1
    cd "$DATE" || exit 1

    if has_cmd rsync; then
      # copy SEMUA kecuali folder 'fitur' dan 'cmd'
      rsync -a . ..
    else
      # fallback tanpa rsync
      find . -mindepth 1 -maxdepth 1 -exec cp -rf {} .. \;
    fi

    cd .. || exit 1
    rm -rf "$DATE"

    npm install || exit 1

    # opsional auto executable
    chmod +x linux 2>/dev/null || true
    ;;

  reinstall)
    sh "$0" uninstall
    sh "$0" install
    ;;

  update)
    case "$2" in
      hard)
        git pull || exit 1
        npm install || exit 1
        ;;
      soft)
        cp config.js /tmp/config_backup.js
        git pull || exit 1
        cp /tmp/config_backup.js config.js
        npm install || exit 1
        ;;
      force)
        cp config.js /tmp/config_backup.js
        sh "$0" reinstall
        cp /tmp/config_backup.js config.js
        ;;
      base)
        cp config.js /tmp/config_backup.js
        DATE=$(date +"%Y%m%d" 2>/dev/null || date +%Y%m%d)
        git clone https://github.com/Barqah-Xiex/brainxiex-bot-whatsapp.git "$DATE" || exit 1
        cd "$DATE" || exit 1
        if has_cmd rsync; then
          rsync -a --exclude='fitur' --exclude='cmd' . ..
        else
          find . -mindepth 1 -maxdepth 1 ! -name 'fitur' ! -name 'cmd' -exec cp -rf {} .. \;
        fi
        cd .. || exit 1
        rm -rf "$DATE"
        npm install || exit 1
        chmod +x linux 2>/dev/null || true
        cp /tmp/config_backup.js config.js
        ;;
      *)
        echo "Usage: $0 update {hard|soft|force|base}"
        echo "  hard   hapus config (default git)"
        echo "  soft   backup & restore config.js"
        echo "  force  reinstall + restore config.js"
        echo "  base   rebase dari repo + restore config.js"
        ;;
    esac
    ;;

  uninstall)
    cd .. || exit 1
    for item in "$DIRNAME"/*; do
      name=$(basename "$item")
      if [ "$name" != "linux" ] && [ "$name" != "windows.bat" ]; then
        rm -rf "$item"
        echo "Menghapus $item"
      fi
    done
    echo "Uninstalled kecuali ./linux dan ./windows.bat"
    cd "$DIRNAME" || exit 1
    ;;

  *)
    echo "Usage: $0 <command>"
    echo ""
    echo "  run                      jalankan dengan node"
    echo "  bun-run                  jalankan dengan bun"
    echo "  install                  clone dan install"
    echo "  reinstall                uninstall + install"
    echo "  update hard|soft|force   update repo"
    echo "  uninstall                hapus file kecuali linux dan windows.bat"
    ;;

esac
