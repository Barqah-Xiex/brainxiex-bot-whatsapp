#!/usr/bin/env sh

dirname=$(basename "$PWD")

case "$1" in
    run)
        if [ ! -d "node_modules" ]; then
            echo "Folder 'node_modules' tidak ditemukan. Menjalankan 'npm install'..."
            npm install
        fi
        node .;
        ;;

    bun-run)
        if ! command -v bun >/dev/null 2>&1; then
            echo "Bun tidak ditemukan. Menginstal Bun..."
            curl -fsSL https://bun.sh/install | bash;
        fi
        if [ ! -d "node_modules" ]; then
            echo "Folder 'node_modules' tidak ditemukan. Menjalankan 'bun install'..."
            bun install;
        fi
        bun .
        ;;

    install)
        tanggal=$(date +"%Y%m%d" 2>/dev/null || date +%Y%m%d)
        git clone https://github.com/Barqah-Xiex/brainxiex-bot-whatsapp.git "$tanggal" || exit 1
        cd "$tanggal" || exit 1

        if command -v rsync >/dev/null 2>&1; then
            rsync -av . ..
        else
            cp -rfv . ..
        fi

        cd ..
        rm -rf "$tanggal";

        npm install;

        # opsional auto make executable
        chmod +x linux 2>/dev/null
        ;;
        
    reinstall)
        sh "$0" uninstall;
        sh "$0" install;
        ;;

    update)
        if [ "$2" = "hard" ]; then
            git pull;
            npm install; 
        elif [ "$2" = "soft" ]; then
            cp config.js /tmp/config_backup.js;
            git pull;
            rm -rfv package*.json bun.lock;
            cp /tmp/config_backup.js config.js;
            npm install;
        elif [ "$2" = "force" ]; then
            cp config.js /tmp/config_backup.js;
            rm -rfv package*.json bun.lock;
            sh "$0" install;
            cp /tmp/config_backup.js config.js;
        else
            echo "Usage: $0 update {hard|soft}"
            echo "  hard                Hapus Config"
            echo "  soft                Tidak Hapus Config"
            echo "  force               Tidak Hapus Config"
        fi
        ;;

    uninstall)
        cd ..
        for item in "$dirname"/*; do
            name=$(basename "$item")
            if [ "$name" != "linux" ] && [ "$name" != "windows.bat" ]; then
                rm -rf "$item";
                echo "Menghapus $item";
            fi
        done
        echo "Uninstalled kecuali ./linux dan ./windows.bat"
        cd "$dirname"
        ;;

    *)
        echo "Usage: $0 <command>"
        echo ""
        echo "  run                      jalankan dengan node"
        echo "  bun-run                  jalankan dengan bun"
        echo "  install                  clone dan install"
        echo "  reinstall                uninstall + install"
        echo "  update hard|soft|force   update repo"
        echo "  uninstall                hapus file kecuali linux dan windows.bat"
        ;;
esac
